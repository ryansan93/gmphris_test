                            foreach($data as $item)
                            {
                                echo '<div class="org-node">';

                                    echo '
                                    <div class="org-box">
                                        <div class="org-title">
                                            '.$item['nama_jabatan'].'
                                        </div>
                                        <div class="org-name">
                                            '.$item['nama'].'
                                        </div>
                                    </div>
                                    ';

                                    if(!empty($item['children']))
                                    {
                                        echo '
                                        <div class="line-down"></div>
                                        <div class="children-wrapper">

                                        ';
                                            renderOrganisasi($item['children']);
                                        echo '
                                        </div>
                                        ';
                                    }

